#!/bin/bash

# ============================================================
# ARA TM — "ag" command: open a tmux session running Antigravity CLI (agy)
# ============================================================
# Creates a new tmux session named "antigravity" and runs `agy` inside it.
# If the session already exists, it attaches to it instead.

SESSION="antigravity"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux attach -t "$SESSION"
else
    tmux new-session -s "$SESSION" "agy"
fi
